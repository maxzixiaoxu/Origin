# Host port bindings for the local stack.
#
# Defaults live in docker-compose.yml and sit in a 5xxxx block so the stack
# never collides with a Postgres, Redis, or dev server already running on the
# conventional ports. Copy this file to .env only if you want to override them.
#
#   cp .env.example .env
#
# Container-internal ports are unaffected; services talk to each other on
# postgres:5432 and redis:6379 regardless of what is published to the host.

JOBQ_POSTGRES_PORT=55432
JOBQ_REDIS_PORT=56379

# Reserved for services added in later phases.
JOBQ_QUEUE_HTTP_PORT=58080
JOBQ_QUEUE_GRPC_PORT=59090
JOBQ_QUEUE_METRICS_PORT=59100
JOBQ_WORKER_METRICS_PORT=59101
JOBQ_ADMIN_PORT=53000
JOBQ_PROMETHEUS_PORT=59091
JOBQ_GRAFANA_PORT=53001
