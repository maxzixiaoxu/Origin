# Build output
/bin/
/dist/
*.exe
*.test
*.out

# Go
vendor/
coverage.txt
coverage.html

# Generated protobuf stubs are committed on purpose (see docs/design-decisions.md),
# so nothing is ignored here.

# Rails
#
# config/master.key decrypts credentials.yml.enc and must never be committed.
# It once was -- see services/admin/.gitignore for how -- so it is listed both
# here and there.
services/admin/config/master.key
services/admin/config/credentials/*.key
services/admin/log/*
!services/admin/log/.keep
services/admin/tmp/*
!services/admin/tmp/.keep
services/admin/storage/*
!services/admin/storage/.keep
services/admin/.bundle/
services/admin/vendor/bundle/
services/admin/public/assets/
services/admin/node_modules/
services/admin/.env*
!services/admin/.env.example

# Local environment
.env
.env.local

# Benchmark artifacts (RESULTS.md is committed; raw runs are not)
bench/raw/
bench/*.json

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Agent tooling noise
.claude/
.claude-flow/
.swarm/
